# AgentForge configuration template
# Copy to .env for local use. Never commit .env or place real secrets here.

# Mutable runtime data. Keep outside the source repository.
AGENTFORGE_DATA_ROOT=D:\\AgentProjectData\\AgentForge

# SQLite URL. The default stores the database below AGENTFORGE_DATA_ROOT.
AGENTFORGE_DATABASE_URL=sqlite+pysqlite:///D:/AgentProjectData/AgentForge/agentforge.db

# Workspace boundary used by planning and read-safe tools.
AGENTFORGE_WORKSPACE_ROOT=D:\\AgentProjects\\AgentForge

# Frontend API origin. Leave unset for the default local backend.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Comma-separated browser origins allowed to call the local API.
AGENTFORGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External provider credentials are intentionally not configured in this demo.
# If enabled later, inject the key through the deployment secret manager.
# OPENAI_API_KEY=
